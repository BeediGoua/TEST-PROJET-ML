+def run_code_batch(specs, timeout):
+    """Execute programs from several tasks in one approved dsh.run_python child.
+
+    Programs are isolated from each other: every candidate gets a fresh deep copy of its task
+    tables and its own Stage-3 per-program timeout.  The process itself is shared only to amortise
+    Python/pandas/scipy startup. State is JSON-only, so the upload stays scanner-friendly.
+    """
