+def _write_batch_state_files(specs, root):
+    """Write one JSON state per unique task and return (paths, state_index_per_program)."""
+    paths = []
+    indices = []
+    seen = {}
+    for spec in specs:
+        dfs = spec["dfs"]
+        key = id(dfs)
+        idx = seen.get(key)
+        if idx is None:
+            dictionary = getattr(dfs, "dictionary", None)
+            state = {
+                "dfs": {str(k): v.to_json(orient="table", date_format="iso") for k, v in dfs.items()},
+                "desc": {str(k): str(v) for k, v in dict(getattr(dfs, "desc", {}) or {}).items()},
+                "dictionary": dictionary.to_json(orient="table", date_format="iso")
+                              if isinstance(dictionary, pd.DataFrame) else None,
+            }
+            idx = len(paths)
+            path = os.path.join(root, f"__dsh_batch_state_{idx}.json")
+            with open(path, "w", encoding="utf-8") as fh:
+                json.dump(state, fh, ensure_ascii=False)
+            paths.append(path)
+            seen[key] = idx
+        indices.append(idx)
+    return paths, indices--- test1:calc_safe_v2
