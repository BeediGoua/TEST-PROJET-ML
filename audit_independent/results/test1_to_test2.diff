+def _arith(expr):
+    expr=expr.replace('−','-').replace('–','-').replace('×','*').replace('÷','/').replace(' minus ',' - ')
+    if not re.fullmatch(r'[\d\s.+\-*/()]+',expr):return None
+    try:tree=ast.parse(expr,mode='eval')
+    except:return None
+    def ev(n):
+        if isinstance(n,ast.Expression):return ev(n.body)
+        if isinstance(n,ast.Constant) and type(n.value) in (int,float):return n.value
+        if isinstance(n,ast.UnaryOp) and type(n.op) in _UN:return _UN[type(n.op)](ev(n.operand))
+        if isinstance(n,ast.BinOp) and type(n.op) in _BIN:return _BIN[type(n.op)](ev(n.left),ev(n.right))
+        raise ValueError
+    try:
+        v=float(ev(tree));return v if math.isfinite(v) else None
+    except:return None--- test1:_clone_tables_for_rule
