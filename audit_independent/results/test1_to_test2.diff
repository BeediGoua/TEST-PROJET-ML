+        __base = {k: pd.read_json(io.StringIO(v), orient="table") for k, v in __st.get("dfs", {}).items()}
+        __dict = pd.read_json(io.StringIO(__st["dictionary"]), orient="table") if __st.get("dictionary") else None
+        __STATE_CACHE[i] = (__base, dict(__st.get("desc", {}) or {}), __dict)
+    __base, __desc, __dictionary = __STATE_CACHE[i]
+    SmartFrame._desc = dict(__desc)
+    dfs = {k: SmartFrame(v.copy(deep=True)) for k, v in __base.items()}
+    return dfs, __dictionary
+'''
+        chunks = []
