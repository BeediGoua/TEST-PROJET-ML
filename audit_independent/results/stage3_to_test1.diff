+def run_codes_many(codes, dfs, timeout, obj=""):
+    """One child for self-consistency samples, with an independent Stage-3 state per candidate."""
+    import dsh
+    if not codes:
+        return []
+    root = tempfile.mkdtemp(prefix="dsh_stage3_many_")
+    try:
+        state_path = _write_sandbox_state(dfs, root)
+        chunks=[]
+        for i, code in enumerate(codes):
+            body=textwrap.indent(code.strip(), "        ") if code.strip() else "        pass"
+            chunk=f"""
+def __candidate_{i}():
+    dfs = _fresh_dfs()
+    _extra = {{"data_dictionary": _DICTIONARY}} if _DICTIONARY is not None else {{}}
+    _orig = pd.read_csv
+    pd.read_csv = _fake_read_csv(dfs, _extra)
+    answer = None
+    try:
+__BODY__
+        return to_float(answer)
+    except BaseException:
+        return None
+    finally:
+        pd.read_csv = _orig
+""".replace("__BODY__", body)
+            chunks.append(chunk)
+        calls=", ".join(f"__candidate_{i}()" for i in range(len(codes)))
+        full_code=_sandbox_header(obj, dfs)+"\n"+"\n".join(chunks)+f"\nRESULT = [{calls}]\n"
+        result=dsh.run_python(full_code, files=[state_path], timeout_s=max(0.8,float(timeout)),
+                              mem_limit_mb=768, max_output=2000)
+        if not result.ok or not isinstance(result.value, list):
+            return [None]*len(codes)
+        vals=[]
+        for v in result.value:
+            vals.append(to_float(v) if v is not None else None)
+        return vals + [None]*max(0,len(codes)-len(vals))
+    except BaseException:
+        return [None]*len(codes)
+    finally:
+        shutil.rmtree(root, ignore_errors=True)